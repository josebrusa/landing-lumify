# Backend origin (no trailing slash). The app calls `${VITE_API_BASE_URL}/api/...`.
VITE_API_BASE_URL=http://localhost:3000

# Deployed sites (Vite inlines this at build time — set in Netlify Site settings, then redeploy):
#
# Test  — remote "origin"  (josebrusa/landing-lumify), branch main
#         Site: https://mellow-meringue-a2f4d9.netlify.app
#         VITE_API_BASE_URL=<Vercel Preview stable URL for backend branch development>
#         Example pattern: https://backend-lumify-git-development-<team>.vercel.app
#
# Prod  — remote "upstream" (lumify7/landing-lumify), branch main
#         Site: https://www.lumify.es
#         VITE_API_BASE_URL=https://backend-lumify.vercel.app
#
# If VITE_API_BASE_URL is missing on Netlify, the client falls back to same-origin `/api`
# (no API on static hosting → 404 on routes like /api/auth/login).
